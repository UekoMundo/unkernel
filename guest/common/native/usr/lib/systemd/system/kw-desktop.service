# The desktop on the machine's display, signed in as "user". A display
# manager needs virtual terminals, which this kernel has none of: logind
# gives seat0 to this one session instead. /usr/lib/kw-desktop is the
# image's session (guest/distro/NAME/Dockerfile).

[Unit]
Description=Desktop session
ConditionPathExists=/dev/dri/card0
After=systemd-user-sessions.service dbus.service systemd-logind.service network.target
Wants=dbus.service systemd-logind.service
Conflicts=shutdown.target

[Service]
User=user
PAMName=login
WorkingDirectory=/home/user
Environment=XDG_SEAT=seat0 XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
EnvironmentFile=-/usr/lib/kw-desktop.env
ExecStart=/bin/bash -l /usr/lib/kw-desktop
Restart=always
RestartSec=2
UtmpIdentifier=seat0
UtmpMode=user
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
